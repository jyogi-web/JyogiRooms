{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "ruby@3.4",
    "nodejs@24",
    "yarn@latest",
    "bundler@latest",
    "postgresql@17",
    "pkg-config@latest",
    "libyaml.dev",
    "git@latest",
    "clang@latest",
    "gnumake@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!'"
    ],
    "scripts": {
      "dev": [
        "./bin/dev"
      ],
      "lint": [
        "./bin/rubocop --autocorrect-all"
      ],
      "setup": [
        "./bin/setup"
      ],
      "test": [
        "./bin/rails db:test:prepare test"
      ]
    }
  }
}
