{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "ruby@3.4",
    "nodejs@24",
    "yarn@latest",
    "bundler@latest",
    "postgresql@17",
    "pkg-config@latest",
    "libyaml.dev",
    "git@latest",
    "clang@latest",
    "gnumake@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!'",
      "if [ \"$(uname)\" = \"Darwin\" ]; then _dd=$(DEVELOPER_DIR= /usr/bin/xcode-select -p 2>/dev/null); if [ -d \"$_dd\" ]; then export DEVELOPER_DIR=\"$_dd\"; _sdk=$(SDKROOT= /usr/bin/xcrun --show-sdk-path 2>/dev/null); [ -d \"$_sdk\" ] && export SDKROOT=\"$_sdk\"; fi; fi"
    ],
    "scripts": {
      "dev": [
        "./bin/dev"
      ],
      "lint": [
        "./bin/rubocop --autocorrect-all"
      ],
      "setup": [
        "./bin/setup"
      ],
      "test": [
        "./bin/rails db:test:prepare test"
      ]
    }
  }
}
