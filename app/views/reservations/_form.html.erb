<%= form_with(model: reservation, local: true, class: "space-y-6") do |f| %>
  <% if reservation.errors.any? %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm">
      <ul class="list-disc pl-5">
        <% reservation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Date (Read-only / Hidden) -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-2">日付</label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= render Icons::CalendarComponent.new(classes: "h-5 w-5 text-gray-400") %>
      </div>
      <!-- Display for User -->
      <input type="text" 
             value="<%= format_date_with_weekday(reservation.reservation_date) %>" 
             disabled 
             class="bg-gray-50 border border-gray-300 text-gray-800 text-sm rounded-lg block w-full pl-10 p-2.5 font-medium cursor-not-allowed">
      
      <!-- Hidden Value for Submission -->
      <%= f.hidden_field :reservation_date %>
    </div>
  </div>

  <!-- Time Selection Grid -->
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-bold text-gray-700 mb-2">開始時間</label>
      <div class="relative">
         <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
           <%= render Icons::ClockComponent.new(classes: "h-5 w-5 text-gray-400") %>
         </div>
         <%= f.time_field :start_time, 
             class: "bg-white border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary focus:border-primary block w-full pl-10 p-2.5", 
             required: true %>
      </div>
    </div>
    <div>
      <label class="block text-sm font-bold text-gray-700 mb-2">終了時間</label>
       <div class="relative">
         <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
           <%= render Icons::ClockComponent.new(classes: "h-5 w-5 text-gray-400") %>
         </div>
        <%= f.time_field :end_time, 
            class: "bg-white border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary focus:border-primary block w-full pl-10 p-2.5", 
            required: true %>
      </div>
    </div>
  </div>

  <!-- Purpose (Optional) -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-2">利用目的（任意）</label>
    <%= f.text_field :purpose, placeholder: "例：面接、会議など", maxlength: 15, class: "bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" %>
  </div>

  <div class="pt-6">
    <%= f.submit submit_text, class: "btn btn-primary w-full justify-center py-3 text-base shadow-lg shadow-primary/30" %>
    
    <p class="text-xs text-center text-gray-500 mt-4">
      ※ 他の予約と時間が重なっている場合は登録できません
    </p>
  </div>
<% end %>
