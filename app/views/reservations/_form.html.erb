<%= form_with(model: reservation, local: true, class: "space-y-6") do |f| %>
  <% if reservation.errors.any? %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm">
      <ul class="list-none space-y-1">
        <% reservation.errors.map(&:message).uniq.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Date (Read-only / Hidden) -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-2">日付</label>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= render Icons::CalendarComponent.new(classes: "h-5 w-5 text-gray-400") %>
      </div>
      <!-- Display for User -->
      <%= tag.input type: "text", 
             value: format_date_with_weekday(reservation.reservation_date), 
             disabled: true, 
             class: "bg-gray-50 border border-gray-300 text-gray-800 text-sm rounded-lg block w-full pl-10 p-2.5 font-medium cursor-not-allowed" %>
      
      <!-- Hidden Value for Submission -->
      <%= f.hidden_field :reservation_date %>
    </div>
  </div>

  <!-- Time Selection Grid -->
  <div class="grid grid-cols-2 gap-2 sm:gap-4 overflow-hidden">
      <div class="min-w-0 overflow-hidden">
       <%= f.label :start_time, "開始時間", class: "block text-sm font-bold text-gray-700 mb-2" %>
       <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <%= render Icons::ClockComponent.new(classes: "h-5 w-5 text-gray-400") %>
          </div>
          <%= f.time_field :start_time,
              class: time_field_class(reservation, :start_time),
              required: true,
              data: { target: "start-time" } %>
       </div>
    </div>
    <div class="min-w-0 overflow-hidden">
      <%= f.label :end_time, "終了時間", class: "block text-sm font-bold text-gray-700 mb-2" %>
       <div class="relative">
         <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
           <%= render Icons::ClockComponent.new(classes: "h-5 w-5 text-gray-400") %>
         </div>
        <%= f.time_field :end_time,
            class: time_field_class(reservation, :end_time),
            required: true,
            data: { target: "end-time" } %>
      </div>
    </div>
  </div>

  <!-- Purpose (Optional) -->
  <div>
    <%= f.label :purpose, "利用目的（任意）", class: "block text-sm font-bold text-gray-700 mb-2" %>
    <%= f.text_field :purpose, placeholder: "例：面接、会議など", maxlength: 15, class: "bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" %>
  </div>

  <!-- 鍵持ちメンション（新規作成時のみ） -->
  <% if reservation.new_record? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :notify_key_holders, { checked: true, class: "w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" }, "1", "0" %>
      <%= f.label :notify_key_holders, "鍵持ちにメンションする", class: "text-sm text-gray-700" %>
    </div>
  <% end %>

  <div class="pt-6">
    <%= f.submit submit_text, class: "btn btn-primary w-full justify-center py-3 text-base shadow-lg shadow-primary/30" %>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const startTime = document.querySelector('[data-target="start-time"]');
    const endTime = document.querySelector('[data-target="end-time"]');
    if (startTime && endTime) {
      startTime.addEventListener("change", function() {
        if (!endTime.value || endTime.value <= startTime.value) {
          endTime.value = startTime.value;
        }
      });
    }
  });
</script>
