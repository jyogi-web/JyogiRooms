<div class="px-4 py-6 md:px-8 space-y-6">
  <!-- Header: Month Navigation -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-gray-800">
        <%= @current_month.year %>年 <%= @current_month.month %>月
      </h1>
      <div class="flex gap-1">
        <%= link_to reservations_path(start_date: @current_month.prev_month), class: "p-1 hover:bg-gray-100 rounded-full transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
        <% end %>
        <%= link_to reservations_path(start_date: @current_month.next_month), class: "p-1 hover:bg-gray-100 rounded-full transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        <% end %>
      </div>
    </div>
    
    <%= link_to reservations_path(start_date: Date.current), class: "text-sm text-primary hover:text-primary-dark font-medium" do %>
      今日に戻る
    <% end %>
  </div>

  <!-- Validations Error Message (if redirected from failed create) -->
  <% if flash[:alert] %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <!-- Calendar Grid -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <!-- Days Header -->
    <div class="grid grid-cols-7 border-b border-gray-100 text-center py-2 bg-gray-50/50">
      <% %w(日 月 火 水 木 金 土).each_with_index do |day, i| %>
        <div class="text-xs font-semibold text-gray-500 <%= 'text-red-500' if i == 0 %> <%= 'text-blue-500' if i == 6 %>">
          <%= day %>
        </div>
      <% end %>
    </div>

    <!-- Days Grid -->
    <div class="grid grid-cols-7 auto-rows-fr bg-gray-100 gap-px border-b border-gray-100">
      <% @calendar_days.each do |date| %>
        <% 
           is_today = date == Date.current
           is_current_month = date.month == @current_month.month
           day_reservations = @reservations.select { |r| r.start_at.to_date == date }
        %>
        
        <%= link_to new_reservation_path(date: date), class: "relative bg-white min-h-[120px] p-2 hover:bg-gray-50 transition-colors group flex flex-col gap-1 #{'opacity-50 bg-gray-50/30' unless is_current_month}" do %>
          <!-- Date Number -->
          <div class="flex justify-between items-start">
            <span class="text-sm rounded-full w-7 h-7 flex items-center justify-center font-medium
              <%= is_today ? 'bg-primary text-white' : (is_current_month ? 'text-gray-700' : 'text-gray-400') %>">
              <%= date.day %>
            </span>
            
            <%# Add Button visual cue on hover %>
            <span class="opacity-0 group-hover:opacity-100 text-primary transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
              </svg>
            </span>
          </div>

          <!-- Reservations List -->
          <div class="flex-1 flex flex-col gap-1 overflow-hidden mt-1 px-1">
            <% day_reservations.each do |res| %>
              <div class="text-[10px] bg-indigo-50 text-indigo-700 border-l-2 border-indigo-500 pl-0.5 md:pl-1 pr-0.5 py-0.5 rounded-sm flex items-center justify-between group/res shadow-sm hover:shadow-md transition-shadow cursor-default">
                <span class="font-bold md:truncate md:mr-1 whitespace-normal break-all leading-tight w-full md:w-auto">
                  <%= res.start_at.strftime("%H:%M") %>~<span class="hidden md:inline"><%= res.end_at.strftime("%H:%M") %></span>
                </span>
                <div class="hidden md:block flex-shrink-0">
                  <%= render UserAvatarComponent.new(user: res.user, size: :xs, extra_classes: "border-0 shadow-none") %>
                </div>
              </div>
            <% end %>
          </div>

        <% end %>
      <% end %>
    </div>
  </div>
</div>
