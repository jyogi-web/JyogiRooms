<div class="px-1 py-6 md:px-8 space-y-6">
  <!-- Header: Month Navigation -->
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-gray-800">
        <%= @current_month.year %>年 <%= @current_month.month %>月
      </h1>
      <div class="flex gap-1">
        <%= link_to reservations_path(start_date: @current_month.prev_month), class: "p-1 hover:bg-gray-100 rounded-full transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
        <% end %>
        <%= link_to reservations_path(start_date: @current_month.next_month), class: "p-1 hover:bg-gray-100 rounded-full transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        <% end %>
      </div>
    </div>
    
    <%= link_to reservations_path(start_date: Date.current), class: "text-sm text-primary hover:text-primary-dark font-medium" do %>
      今日に戻る
    <% end %>
  </div>

  <!-- Validations Error Message (if redirected from failed create) -->
  <% if flash[:alert] %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <!-- Calendar Grid -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <!-- Days Header -->
    <div class="grid grid-cols-7 border-b border-gray-100 text-center py-2 bg-gray-50/50">
      <% %w(日 月 火 水 木 金 土).each_with_index do |day, i| %>
        <div class="text-xs font-semibold text-gray-500 <%= 'text-red-500' if i == 0 %> <%= 'text-blue-500' if i == 6 %>">
          <%= day %>
        </div>
      <% end %>
    </div>

    <!-- Days Grid -->
    <div class="grid grid-cols-7 auto-rows-min bg-gray-100 gap-px border-b border-gray-100">
      <% @calendar_days.each do |date| %>
        <%= render Calendar::DayComponent.new(
              date: date, 
              current_month: @current_month, 
              reservations_by_date: @reservations_by_date
            ) %>
      <% end %>
    </div>
  </div>
</div>
