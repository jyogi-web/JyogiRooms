<% 
  is_active = item[:active]
  base_desktop = "flex items-center px-4 py-3 gap-3 rounded-lg transition-all duration-150 group active:scale-95 active:opacity-80"
  style_desktop = is_active ? "bg-primary text-white" : "text-gray-600 hover:bg-gray-50 hover:text-primary"
  icon_desktop = is_active ? "text-white" : "group-hover:text-primary"

  base_mobile = "flex flex-col items-center justify-center w-full h-full group transition-all duration-150 active:scale-90 active:opacity-70"
  style_mobile = is_active ? "text-primary" : "text-gray-400 hover:text-primary active:text-primary"
  icon_mobile = is_active ? "text-primary" : "group-hover:text-primary group-active:text-primary"
%>

<% if mode == :desktop %>
  <%= link_to item[:path], class: "#{base_desktop} #{style_desktop}", data: { turbo: true } do %>
    <%= nav_icon(item[:icon], "w-5 h-5 #{icon_desktop}") %>
    <span class="font-medium"><%= item[:label] %></span>
  <% end %>
<% else %>
  <%= link_to item[:path], class: "#{base_mobile} #{style_mobile}", data: { turbo: true } do %>
    <%= nav_icon(item[:icon], "w-6 h-6 #{icon_mobile}") %>
    <span class="text-[10px] mt-1 font-medium"><%= item[:label] %></span>
  <% end %>
<% end %>
