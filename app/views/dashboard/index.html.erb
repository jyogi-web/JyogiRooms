<div class="space-y-6 px-4 py-6 md:px-8">
    <h2 class="text-xl font-bold text-gray-800">今日の予約</h2>

  <%# Today's Reservations %>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% if @reservations.any? %>
      <% @reservations.each do |reservation| %>
        <div class="card flex flex-col gap-2 relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-1 h-full bg-primary"></div>
          <div class="flex justify-between items-start pl-2">
            <div>
              <p class="text-sm font-bold text-gray-800">
                <%= reservation.start_at.strftime("%H:%M") %> - <%= reservation.end_at.strftime("%H:%M") %>
              </p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-gray-700"><%= reservation.user.display_name || "Unknown" %></span>
              <%= render(UserAvatarComponent.new(user: reservation.user, size: :small, extra_classes: "bg-gray-200")) %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full card py-8 text-center text-gray-500">
        予約はありません
      </div>
    <% end %>
  </div>

  <div class="h-px bg-gray-200 my-6"></div>

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold text-gray-800">現在の鍵持ち</h2>
  </div>

  <%# Key Holders %>
  <div class="grid gap-4 grid-cols-1 md:grid-cols-3">
    <% @rooms.each do |room| %>
      <div class="card p-5">
        <h3 class="text-lg font-bold text-gray-800 mb-4"><%= room.name %></h3>
        
        <div class="flex flex-wrap gap-2">
          <% if room.keys.any? %>
            <% room.keys.each do |key| %>
              <div class="relative group cursor-pointer">
                <%= render(UserAvatarComponent.new(user: key.user, size: :medium)) %>
                
                <%# Tooltip %>
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                  <%= key.user&.display_name || "Unknown" %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-gray-400">鍵持ちはいません</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
