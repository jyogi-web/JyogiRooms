<div class="space-y-6 px-4 py-6 md:px-8">
<h1 class="text-2xl font-bold text-gray-900">管理画面</h1>

<%= render "admin/nav" %>

<h2 class="text-xl font-bold text-gray-800">施錠アナウンス設定</h2>

<% if notice %>
  <div class="p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-700">
    <%= notice %>
  </div>
<% end %>

<div class="card p-6 max-w-2xl">
  <%= form_with(model: [:admin, @announcement], url: admin_scheduled_announcement_path(@announcement), method: :patch) do |f| %>
    <% if @announcement.errors.any? %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
        <ul class="text-sm text-red-700">
          <% @announcement.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-5">
      <!-- 有効/無効 -->
      <div class="flex items-center gap-3">
        <%= f.check_box :enabled, class: "w-5 h-5 text-primary border-gray-300 rounded focus:ring-primary" %>
        <%= f.label :enabled, "アナウンスを有効にする", class: "text-sm font-medium text-gray-700" %>
      </div>

      <!-- 実行時刻 -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">実行時刻（JST）</label>
        <div class="flex items-center gap-2">
          <%= f.select :hour, (0..23).map { |h| [format("%02d", h), h] },
              {}, class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" %>
          <span class="text-gray-500 font-medium">:</span>
          <%= f.select :minute, (0..59).select { |m| m % 5 == 0 }.map { |m| [format("%02d", m), m] },
              {}, class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" %>
        </div>
      </div>

      <!-- メッセージ -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <%= f.label :message, "アナウンス文面", class: "text-sm font-medium text-gray-700" %>
          <button type="button"
            onclick="if(confirm('文面をデフォルトに戻しますか？')) document.getElementById('announcement-message').value = this.dataset.defaultMessage"
            data-default-message="<%= ScheduledAnnouncement::DEFAULT_MESSAGE %>"
            class="text-xs text-gray-500 hover:text-primary underline cursor-pointer">
            デフォルト文面に戻す
          </button>
        </div>
        <%= f.text_area :message, rows: 6, id: "announcement-message",
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent",
            placeholder: "Discordに送信されるメッセージを入力してください" %>
        <p class="mt-1 text-xs text-gray-500">Discordのマークダウン記法（**太字**、\nで改行）が使えます</p>
      </div>

      <!-- プレビュー -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">現在の設定</label>
        <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
          <p class="text-sm text-gray-600">
            状態: <span class="font-medium <%= @announcement.enabled? ? 'text-green-600' : 'text-red-600' %>">
              <%= @announcement.enabled? ? "有効" : "無効" %>
            </span>
          </p>
          <p class="text-sm text-gray-600">
            実行時刻: <span class="font-medium"><%= @announcement.scheduled_time_display %> JST</span>
          </p>
        </div>
      </div>

      <div>
        <%= f.submit "保存", class: "px-6 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
</div>
