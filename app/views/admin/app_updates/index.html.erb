<div class="space-y-6 px-4 py-6 md:px-8">
<h1 class="text-2xl font-bold text-gray-900">🛡️ 管理画面</h1>

<%= render "admin/nav" %>

<div class="flex items-center justify-between">
  <h2 class="text-xl font-bold text-gray-800">アップデート情報</h2>
  <%= link_to new_admin_app_update_path, class: "btn btn-primary text-sm" do %>
    + 新規追加
  <% end %>
</div>

<% if flash[:notice] %>
  <div class="bg-green-50 text-green-700 p-4 rounded-lg text-sm">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if @app_updates.empty? %>
  <div class="card p-8 text-center text-gray-400">
    アップデート情報はまだありません
  </div>
<% else %>
  <div class="space-y-3">
    <% @app_updates.each do |update| %>
      <div class="card p-5">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h3 class="text-lg font-bold text-gray-800"><%= update.title %></h3>
          <span class="shrink-0 text-xs font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded"><%= update.released_on.strftime("%Y/%m/%d") %></span>
        </div>
        <p class="text-sm text-gray-600 whitespace-pre-wrap mb-3"><%= update.description %></p>
        <div class="flex gap-2">
          <%= link_to "編集", edit_admin_app_update_path(update), class: "text-sm text-primary hover:text-primary-dark font-medium" %>
          <%= button_to "削除", admin_app_update_path(update), method: :delete,
              class: "text-sm text-red-500 hover:text-red-700 font-medium",
              form: { onsubmit: "return confirm('「#{j(update.title)}」を削除しますか？')" } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
</div>
