<div class="space-y-6 px-4 py-6 md:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">鍵の割り当て</h1>
    <%= link_to "戻る", keys_path, class: "text-sm text-primary hover:text-primary-dark font-medium" %>
  </div>

  <div class="card p-6 space-y-6">
    <div class="space-y-2">
      <p class="text-sm text-gray-600">部屋</p>
      <p class="text-lg font-semibold text-gray-900"><%= @room.name %></p>
    </div>

    <div class="space-y-2">
      <p class="text-sm text-gray-600">未割り当ての鍵</p>
      <p class="text-sm text-gray-800"><%= @room.keys.count { |k| k.user_id.nil? } %>本</p>
    </div>

    <div class="space-y-3">
      <p class="text-sm text-gray-600">割り当て先</p>
      <% if @eligible_users.any? %>
        <%= form_with url: assign_room_key_path(@room.id), method: :post, local: true, class: "space-y-4" do |form| %>
          <div>
            <%= form.select :to_user_id,
                options_for_select(@eligible_users.map { |u| [u.display_name, u.id] }),
              { prompt: "ユーザーを選択" },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent",
              required: true %>
          </div>
          <div>
            <%= form.submit "割り当てる", class: "w-full px-4 py-2 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors text-sm" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500">割り当て可能なユーザーがいません。</p>
      <% end %>
    </div>
  </div>
</div>
