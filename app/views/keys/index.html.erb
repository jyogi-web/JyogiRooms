<div class="space-y-6 px-4 py-6 md:px-8">
  <h1 class="text-2xl font-bold text-gray-800">鍵管理</h1>

  <!-- Flash Messages -->
  <% if flash[:notice] %>
    <div class="bg-green-50 text-green-700 p-4 rounded-lg text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg text-sm">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <!-- Key Holders Grid -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <% @rooms.each do |room| %>
      <div class="card p-6">
        <!-- Room Name -->
        <h2 class="text-lg font-bold text-gray-800 mb-4"><%= room.name %></h2>

        <!-- Current Key Holder -->
        <div class="mb-6 pb-6 border-b border-gray-200">
          <p class="text-sm font-semibold text-gray-600 mb-3">現在の鍵持ち</p>
          <div class="flex flex-wrap gap-4">
            <% if room.keys.any? %>
              <% room.keys.each do |key| %>
                <div class="flex flex-col items-center gap-2">
                  <div class="relative group cursor-pointer">
                    <%= render(UserAvatarComponent.new(user: key.user, size: :medium)) %>
                    
                    <%# Tooltip %>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">
                      <%= key.user&.display_name || "Unknown" %>
                    </div>
                  </div>
                  <p class="text-xs text-gray-700 font-medium text-center"><%= key.user&.display_name || "Unknown" %></p>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-400">未設定</p>
            <% end %>
          </div>
        </div>

        <!-- Key Transfer Form -->
        <% if room.keys.exists?(user_id: current_user.id) %>
          <div>
            <p class="text-sm font-semibold text-gray-600 mb-3">鍵を譲渡</p>
            <%= form_with url: room_key_transfer_path(room.id), method: :post, local: true, class: "space-y-3" do |form| %>
              <!-- User Select -->
              <div>
                <%= form.select :to_user_id, 
                    options_for_select(@users.map { |u| [u.display_name, u.id] }), 
                    { prompt: "ユーザーを選択" },
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" %>
              </div>

              <!-- Submit Button -->
              <div>
                <%= form.submit "譲渡する", 
                    class: "w-full px-4 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors text-sm" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
