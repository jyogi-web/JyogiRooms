<div class="space-y-6 px-4 py-6 md:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">🔑 鍵の譲渡</h1>
    <%= link_to "戻る", keys_path, class: "text-sm text-primary hover:text-primary-dark font-medium" %>
  </div>

  <div class="card p-6 space-y-6">
    <div class="space-y-2">
      <p class="text-sm text-gray-600">部屋</p>
      <p class="text-lg font-semibold text-gray-900"><%= @room.name %></p>
    </div>

    <div class="space-y-3">
      <p class="text-sm text-gray-600">譲渡元</p>
      <div class="flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-lg p-3">
        <%= render(UserAvatarComponent.new(user: @from_user, size: :small)) %>
        <div>
          <p class="text-sm font-semibold text-gray-800"><%= @from_user.display_name %></p>
          <p class="text-xs text-gray-500">現在この部屋の鍵を保持</p>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <p class="text-sm text-gray-600">譲渡先</p>
      <% if @eligible_users.any? %>
        <%= form_with url: transfer_room_key_path(@room.id), method: :post, local: true, class: "space-y-4", id: "transfer-form" do |form| %>
          <%= form.hidden_field :from_user_id, value: @from_user.id %>
          <%= form.hidden_field :to_user_id, id: "selected-user-id", required: true %>
          <div class="relative" id="user-search-container">
            <label for="user-search-input" class="sr-only">譲渡先ユーザーを検索</label>
            <input type="text" id="user-search-input" placeholder="ユーザー名またはIDで検索" autocomplete="off"
              role="combobox" aria-expanded="false" aria-controls="user-search-results" aria-autocomplete="list"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            <div id="user-search-results" role="listbox" aria-label="検索結果" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto"></div>
          </div>
          <div id="selected-user-display" class="hidden flex items-center justify-between bg-blue-50 border border-blue-200 rounded-lg p-3">
            <div class="flex items-center gap-3">
              <img id="selected-user-avatar" class="w-8 h-8 rounded-full" src="" alt="">
              <div>
                <p id="selected-user-name" class="text-sm font-semibold text-gray-800"></p>
                <p id="selected-user-username" class="text-xs text-gray-500"></p>
              </div>
            </div>
            <button type="button" id="clear-selection" class="text-gray-400 hover:text-gray-600 text-lg">&times;</button>
          </div>
          <div>
            <%= form.submit "譲渡する", class: "w-full px-4 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors text-sm disabled:opacity-50 disabled:cursor-not-allowed", id: "submit-btn", disabled: true %>
          </div>
        <% end %>

        <script>
          (function() {
            const users = JSON.parse('<%= j @eligible_users.map { |u| { id: u.id, display_name: u.display_name, username: u.username, avatar_url: u.avatar_url } }.to_json %>');
            const input = document.getElementById('user-search-input');
            const results = document.getElementById('user-search-results');
            const hiddenField = document.getElementById('selected-user-id');
            const selectedDisplay = document.getElementById('selected-user-display');
            const selectedName = document.getElementById('selected-user-name');
            const selectedUsername = document.getElementById('selected-user-username');
            const selectedAvatar = document.getElementById('selected-user-avatar');
            const clearBtn = document.getElementById('clear-selection');
            const submitBtn = document.getElementById('submit-btn');

            function toKatakana(s) { return s.replace(/[\u3041-\u3096]/g, c => String.fromCharCode(c.charCodeAt(0) + 0x60)); }

            function filterUsers(query) {
              if (!query) return users;
              const q = toKatakana(query.toLowerCase());
              return users.filter(u =>
                toKatakana(u.display_name.toLowerCase()).includes(q) ||
                (u.username && u.username.toLowerCase().includes(q))
              );
            }

            function renderResults(filtered) {
              results.textContent = '';
              if (filtered.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'px-3 py-2 text-sm text-gray-400';
                empty.textContent = '該当するユーザーがいません';
                results.appendChild(empty);
              } else {
                filtered.forEach(u => {
                  const row = document.createElement('button');
                  row.type = 'button';
                  row.className = 'flex items-center gap-3 px-3 py-2 hover:bg-gray-50 cursor-pointer transition-colors w-full text-left';
                  row.setAttribute('role', 'option');
                  row.dataset.userId = u.id;

                  const img = document.createElement('img');
                  img.src = u.avatar_url || '';
                  img.className = 'w-7 h-7 rounded-full bg-gray-200';
                  img.alt = '';
                  img.onerror = function() { this.style.display = 'none'; };
                  row.appendChild(img);

                  const info = document.createElement('div');
                  info.className = 'min-w-0';
                  const name = document.createElement('p');
                  name.className = 'text-sm font-medium text-gray-800 truncate';
                  name.textContent = u.display_name;
                  info.appendChild(name);
                  if (u.username) {
                    const uname = document.createElement('p');
                    uname.className = 'text-xs text-gray-500';
                    uname.textContent = '@' + u.username;
                    info.appendChild(uname);
                  }
                  row.appendChild(info);
                  results.appendChild(row);
                });
              }
              results.classList.remove('hidden');
              input.setAttribute('aria-expanded', 'true');
            }

            function selectUser(userId) {
              const user = users.find(u => u.id === userId);
              if (!user) return;
              hiddenField.value = user.id;
              selectedName.textContent = user.display_name;
              selectedUsername.textContent = user.username ? '@' + user.username : '';
              selectedAvatar.src = user.avatar_url || '';
              selectedDisplay.classList.remove('hidden');
              input.classList.add('hidden');
              results.classList.add('hidden');
              submitBtn.disabled = false;
            }

            function clearSelection() {
              hiddenField.value = '';
              selectedDisplay.classList.add('hidden');
              input.classList.remove('hidden');
              input.value = '';
              input.focus();
              submitBtn.disabled = true;
            }

            input.addEventListener('input', () => renderResults(filterUsers(input.value)));
            input.addEventListener('focus', () => renderResults(filterUsers(input.value)));
            results.addEventListener('click', (e) => {
              const row = e.target.closest('[data-user-id]');
              if (row) selectUser(parseInt(row.dataset.userId));
            });
            clearBtn.addEventListener('click', clearSelection);
            document.addEventListener('click', (e) => {
              if (!e.target.closest('#user-search-container')) {
                results.classList.add('hidden');
                input.setAttribute('aria-expanded', 'false');
              }
            });
          })();
        </script>
      <% else %>
        <p class="text-sm text-gray-500">譲渡可能なユーザーがいません。</p>
      <% end %>
    </div>
  </div>
</div>
