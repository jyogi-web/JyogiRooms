<div class="space-y-6 px-4 py-6 md:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">🔑 鍵の譲渡</h1>
    <%= link_to "戻る", keys_path, class: "text-sm text-primary hover:text-primary-dark font-medium" %>
  </div>

  <div class="card p-6 space-y-6">
    <div class="space-y-2">
      <p class="text-sm text-gray-600">部屋</p>
      <p class="text-lg font-semibold text-gray-900"><%= @room.name %></p>
    </div>

    <div class="space-y-3">
      <p class="text-sm text-gray-600">譲渡元</p>
      <div class="flex items-center gap-3 bg-gray-50 border border-gray-200 rounded-lg p-3">
        <%= render(UserAvatarComponent.new(user: @from_user, size: :small)) %>
        <div>
          <p class="text-sm font-semibold text-gray-800"><%= @from_user.display_name %></p>
          <p class="text-xs text-gray-500">現在この部屋の鍵を保持</p>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <p class="text-sm text-gray-600">譲渡先</p>
      <% if @eligible_users.any? %>
        <%= form_with url: transfer_room_key_path(@room.id), method: :post, local: true, class: "space-y-4" do |form| %>
          <%= form.hidden_field :from_user_id, value: @from_user.id %>
          <div>
            <%= form.label :to_user_id, "譲渡先", class: "sr-only" %>
            <%= form.select :to_user_id,
                options_for_select(@eligible_users.map { |u| [u.display_name, u.id] }),
              { prompt: "ユーザーを選択" },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent",
              required: true %>
          </div>
          <div>
            <%= form.submit "譲渡する", class: "w-full px-4 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors text-sm" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500">譲渡可能なユーザーがいません。</p>
      <% end %>
    </div>
  </div>
</div>
