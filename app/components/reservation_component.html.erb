<% if @layout == :dashboard %>
  <!-- Dashboard Style: Box with Blue Sidebar -->
  <div class="card flex flex-col gap-2 relative overflow-hidden group border border-gray-100 shadow-sm">
    <div class="absolute top-0 left-0 w-1 h-full bg-primary"></div>
    <div class="flex justify-between items-center pl-3 py-1">
      <div class="flex-shrink-0">
        <p class="text-sm font-bold text-gray-800">
          <%= start_time %> ~ <%= end_time %>
        </p>
      </div>
      <% if purpose.present? %>
        <div class="flex-1 px-3 text-left min-w-0">
          <span class="text-sm font-medium text-gray-700 truncate block"><%= purpose %></span>
        </div>
      <% else %>
        <div class="flex-1"></div>
      <% end %>
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="text-sm font-medium text-gray-700"><%= user_name %></span>
        <%= render(UserAvatarComponent.new(user: @reservation.user, size: :small, extra_classes: "bg-gray-200")) %>
      </div>
    </div>
  </div>

<% elsif @layout == :list %>
  <!-- List Style: Simple Row with Avatar Left -->
  <div class="flex items-center justify-between bg-white p-3 rounded-lg shadow-sm border border-blue-100">
    <div class="flex items-center min-w-0">
      <div class="flex-shrink-0 mr-3">
        <%= render UserAvatarComponent.new(user: @reservation.user, size: :small) %>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-medium text-gray-900 truncate">
          <%= user_name %>
        </div>
        <div class="flex items-center gap-2 mt-0.5">
          <div class="text-xs text-gray-500 whitespace-nowrap">
            <%= start_time %> ~ <%= end_time %>
          </div>
          <% if purpose.present? %>
            <div class="text-xs text-gray-600 bg-gray-100 px-2 py-0.5 rounded truncate max-w-[200px]">
              <%= purpose %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <% if owned_by_current_user? %>
      <div class="flex items-center gap-2 ml-4">
        <%= link_to edit_reservation_path(@reservation), class: "text-gray-400 hover:text-blue-500 p-1 rounded-full hover:bg-blue-50 transition-colors", title: "編集" do %>
          <%= render Icons::PencilComponent.new(classes: "w-4 h-4") %>
        <% end %>
        <%= render Ui::ConfirmModalComponent.new(
              trigger_icon: render(Icons::TrashComponent.new(classes: "w-4 h-4")),
              title: "予約の削除",
              confirm_text: "削除する"
            ) do %>
          <%= button_to "削除する", reservation_path(@reservation), method: :delete, class: "px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
        <% end %>
      </div>
    <% end %>
  </div>

<% end %>
