<%= link_to new_reservation_path(date: @date), class: container_classes do %>
  <!-- Date Number -->
  <div class="flex justify-between items-start">
    <span class="<%= date_circle_classes %>">
      <%= @date.day %>
    </span>
    
    <%# Add Button visual cue on hover %>
    <span class="opacity-0 group-hover:opacity-100 text-primary transition-opacity">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
        <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
      </svg>
    </span>
  </div>

  <!-- Reservations List -->
  <div class="flex-1 flex flex-col gap-1 overflow-hidden mt-1 px-1">
    <% day_reservations.each do |res| %>
      <div class="text-[10px] bg-indigo-50 text-indigo-700 border-l-2 border-indigo-500 pl-0.5 md:pl-1 pr-0.5 py-0.5 rounded-sm flex items-center justify-between group/res shadow-sm hover:shadow-md transition-shadow cursor-default">
        <span class="font-bold md:truncate md:mr-1 whitespace-normal break-all leading-tight w-full md:w-auto">
          <%= res.start_at.strftime("%H:%M") %>~<span class="hidden md:inline"><%= res.end_at.strftime("%H:%M") %></span>
        </span>
        <div class="hidden md:block flex-shrink-0">
          <%= render UserAvatarComponent.new(user: res.user, size: :xs, extra_classes: "border-0 shadow-none") %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
