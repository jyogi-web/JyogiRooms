# Database
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_TEST_NAME=
DB_USERNAME=

# 注意: DATABASE_URL を設定すると全環境（test を含む）で database.yml より優先される。
# 本番・開発用の DATABASE_URL を .env に書く場合は、テストが本番DBを参照しないよう
# .env.test でローカルのテスト用 DATABASE_URL を必ず上書きすること。
# DATABASE_URL=

# OAuth2 / Authentication
CLIENT_ID=
CLIENT_SECRET=
FRONTEND_URL=
JYOGI_AUTH_URL=
REDIRECT_URI=

# SSL検証を無効化する場合はfalseに設定（デフォルトはtrue）
JYOGI_SSL_VERIFY=

# Discord API（通知送信用）
DISCORD_BOT_TOKEN=
ANNOUNCE_CHANNEL_ID=

# discord botとの連携
API_ACCESS_TOKEN=
# 管理者のDiscord ID（カンマ区切り）
ADMIN_DISCORD_IDS=

# 閲覧ログ取り込み（view-log-worker / Cloudflare）
# 未設定なら閲覧ログ記録は無効（no-op）になる
VIEW_LOG_INGEST_URL=
VIEW_LOG_INGEST_SECRET=
